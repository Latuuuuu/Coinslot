# Discord application (Developer Portal)
DISCORD_TOKEN=
DISCORD_APP_ID=
# Private server where the bot lives
GUILD_ID=
# Channel for logging entries and receiving reminders / weekly reports
LEDGER_CHANNEL_ID=
# The only user allowed to use the bot
OWNER_USER_ID=

TIMEZONE=Asia/Taipei
# Nightly reminder time (HH:MM, in TIMEZONE)
REMINDER_TIME=22:00
# Weekly report (DAY HH:MM, DAY = MON..SUN, in TIMEZONE)
WEEKLY_REPORT=SUN 21:00
# Monthly report for the previous month (D HH:MM, D = 1..28, in TIMEZONE)
MONTHLY_REPORT=1 21:00
# Local dev path; docker-compose overrides this to /data/coinslot.db
DB_PATH=./data/coinslot.db
# Optional: Uptime Kuma push monitor URL for heartbeats
UPTIME_KUMA_PUSH_URL=

# Web UI (reach it through Tailscale; see README)
WEB_PORT=8080
# Optional: comma-separated Tailscale logins allowed in (checked via `tailscale serve` headers)
WEB_ALLOWED_USERS=
# Development only: 1 = serve the web UI without logging in to Discord
WEB_ONLY=0
